---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
---

<BaseLayout title="Jordi Capellades" description="Personal site of Jordi Capellades — web developer. Thoughts, projects, and photography.">
  <h1 class="sr-only">Jordi Capellades</h1>
  <section class="flex gap-4">
    <div>
      <div class="mt-2">
        <p class="text-fg"><span class="text-fg-emphasis font-medium">I'm Jordi</span>, a web developer. This is where I keep what I'm thinking about, what I'm building, and what I've seen. A small corner of the internet that's mine.</p>
      </div>
    </div>
  </section>
  <section class="mt-20">
    <ul class="space-y-2">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="group flex items-baseline justify-between gap-4 text-md text-fg hover:text-fg-strong transition-colors">
              <span>{post.data.title}</span>
              <span class="font-mono text-sm text-fg-muted group-hover:text-fg transition-colors">{formatDate(post.data.pubDate)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
