---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Jordi Capellades"
  description="Personal site of Jordi Capellades."
>
  <section class="mb-12">
    <div class="flex items-start justify-between gap-6">
      <p class="font-medium">Jordi Capellades</p>
      <img
        src="/dithering-profile.png"
        alt="Jordi Capellades"
        class="mb-6 text-right border-2 border-white shadow h-32 w-32 rounded-md object-cover"
      />
    </div>
    <p class="font-mono opacity-80 text-pretty leading-relaxed">
      Hi I'm Jordi, a software engineer in Barcelona who loves to build cool
      things. I really enjoy designing and developing web applications, and I
      have a passion for learning new technologies and improving my skills. In
      my free time, I like to explore mountains, <a
        href="map"
        class="hover:underline hover:text-blue-600">travel</a
      >, <a href="books" class="hover:underline hover:text-blue-600"
        >read books</a
      >, <a href="running" class="hover:underline hover:text-blue-600"
        >running</a
      >, <a href="photos" class="hover:underline hover:text-blue-600"
        >taking photos</a
      >, <a href="calistenics" class="hover:underline hover:text-blue-600"
        >calistenics</a
      > and I just start practicing <a
        href="jiu-jitsu"
        class="hover:underline hover:text-blue-600">jiu-jitsu</a
      >.
    </p>
  </section>
</BaseLayout>
