---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DitherPortrait from '../components/DitherPortrait';
import ChatCircleFill from 'phosphor-astro/ChatCircleFill.astro';
import SunFill from 'phosphor-astro/SunFill.astro';
import CloudFill from 'phosphor-astro/CloudFill.astro';
import CloudFogFill from 'phosphor-astro/CloudFogFill.astro';
import CloudRainFill from 'phosphor-astro/CloudRainFill.astro';
import SnowflakeFill from 'phosphor-astro/SnowflakeFill.astro';
import CloudLightningFill from 'phosphor-astro/CloudLightningFill.astro';

// all rendered hidden; the inline script reveals the one matching the WMO bucket
const weatherIcons = [
  ['sunny', SunFill],
  ['cloudy', CloudFill],
  ['foggy', CloudFogFill],
  ['rainy', CloudRainFill],
  ['snowy', SnowflakeFill],
  ['stormy', CloudLightningFill],
] as const;

// ponytail: empty bento sketch — cells are labeled placeholders, fill one at a time
const cells = [
  { label: 'GitHub', span: 'col-span-2', github: true },
  { label: 'Now', span: '', clock: true },
  { label: 'Today', span: '', today: true },
];

// what I'm up to right now — edit freely
const todayItems = ['Reading 1984 — George Orwell', 'Training 4/5 a week', 'Working at Ticketdoor'];

// build-time initial clock value; the inline script takes over on load
const initialTime = new Intl.DateTimeFormat('en-GB', {
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Europe/Madrid',
}).format(new Date());

// GitHub's own heatmap palette, level 0-4
const GH_LEVELS = ['#ebedf0', '#9be9a8', '#40c463', '#30a14e', '#216e39'];
const year = new Date().getFullYear();

// ponytail: build-time snapshot via unauthenticated jogruber API; swap to
// GitHub GraphQL + token if it ever disappears
let gh: { total: number; days: { date: string; count: number; level: number }[] } | null = null;
try {
  const res = await fetch(`https://github-contributions-api.jogruber.de/v4/jordizone?y=${year}`);
  const data = await res.json();
  const today = new Date().toISOString().slice(0, 10);
  gh = {
    total: data.total[year],
    days: data.contributions.filter((d: { date: string }) => d.date <= today).slice(-182),
  };
} catch {
  // build without the cell rather than failing the build
}

const feed = (await getCollection('feed', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Jordi Capellades" description="Personal site of Jordi Capellades — web developer." wide>
  <h1 class="sr-only">Jordi Capellades</h1>
  <div class="bento grid grid-cols-2 md:grid-cols-4 auto-rows-[minmax(12rem,auto)] gap-4">
    <div class="col-span-2 md:row-span-2 flex flex-col justify-between gap-8 rounded-2xl p-6 overflow-hidden">
      <div
        role="img"
        aria-label="Dithered portrait of Jordi"
        class="stagger-item w-44 h-44 overflow-hidden rounded-full bg-[#0039F6] outline outline-1 -outline-offset-1 outline-black/5"
        style="corner-shape: squircle; --i:0"
      >
        <DitherPortrait client:idle />
      </div>
      <p class="stagger-item text-fg text-pretty" style="--i:1">
        <span class="text-fg-emphasis font-medium">I'm Jordi</span>, a web developer. This is where I
        keep what I'm thinking about, what I'm building, and what I've seen. A small corner of the
        internet that's mine.
      </p>
    </div>
    {
      cells.map((cell) =>
        cell.github && gh ? (
          <a
            href="https://github.com/jordizone"
            class:list={[
              'card-shadow flex flex-col gap-3 rounded-2xl border border-border p-4 transition-[border-color,color,scale] duration-150 ease-out hover:border-border-strong active:scale-[0.96]',
              cell.span,
            ]}
            style="--base:260ms"
          >
            <div class="stagger-item flex items-center justify-between gap-2" style="--i:0">
              <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" class="shrink-0 text-fg-strong" aria-hidden="true">
                <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
              </svg>
              <p class="truncate text-xs text-fg-muted tabular-nums">
                <span class="font-numeric font-medium text-fg-emphasis">{gh.total}</span> in {year}
              </p>
            </div>
            <div class="grid flex-1 content-center grid-cols-26 gap-[3px]">
              {gh.days.map((day, i) => {
                // column-by-column sweep: delay follows column-major order
                const colDelay = ((i % 26) * 7 + Math.floor(i / 26)) * 6;
                return (
                  <div
                    class="heatmap-cell aspect-square rounded-[2px]"
                    style={`background:${GH_LEVELS[day.level]};--d:${colDelay}ms`}
                    title={`${day.count} on ${day.date}`}
                  />
                );
              })}
            </div>
          </a>
        ) : cell.clock ? (
          <div class="card-shadow flex items-center rounded-2xl bg-neutral-900 p-4" style="--base:320ms">
            <p class="text-2xl font-semibold leading-snug text-neutral-500">
              <span class="stagger-item block" style="--i:0">
                <span id="clock" class="font-numeric text-white tabular-nums">{initialTime}</span> now
              </span>
              <span class="stagger-item block" style="--i:1">
                in <span class="text-white">Barcelona</span>
              </span>
              <span class="stagger-item block" style="--i:2">
                feels <span id="temp" class="font-numeric text-white tabular-nums">–</span>
              </span>
              <span class="stagger-item block whitespace-nowrap" style="--i:3">
                {weatherIcons.map(([word, Icon]) => (
                  <Icon data-cond={word} width={20} height={20} class="weather-in align-[-2px]" style="display:none" aria-hidden="true" />
                ))}{' '}
                <span id="cond" class="text-white"></span>
              </span>
            </p>
          </div>
        ) : cell.today ? (
          <div class="card-shadow flex flex-col rounded-2xl bg-amber-400 p-1.5" style="--base:380ms">
            <div class="flex flex-1 flex-col gap-2 rounded-[10px] bg-white p-3 shadow-sm">
              <p class="stagger-item text-sm font-medium text-fg-emphasis" style="--i:0">Now</p>
              <ul class="flex flex-1 flex-col justify-around gap-1.5">
                {todayItems.map((item, i) => (
                  <li class="stagger-item flex items-start gap-2 text-xs text-fg" style={`--i:${i + 1}`}>
                    <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-400" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
            <p class="stagger-item px-2 pt-1 font-mono text-[10px] text-amber-800" style="--i:4">now.md</p>
          </div>
        ) : null
      )
    }
  </div>
  {feed.length > 0 && (
  <section class="mt-16">
    <h2 class="mb-4 text-sm font-medium text-fg-emphasis">Feed</h2>
    <ul class="flex flex-col gap-4">
      {
        feed.map((item, i) => {
          const Row = item.data.url ? 'a' : 'div';
          return (
            <li class="stagger-item" style={`--i:${i}; --base:500ms`}>
              <Row
                {...(item.data.url && { href: item.data.url })}
                class="card-shadow flex items-center gap-3 rounded-2xl border border-border p-4 transition-[border-color] hover:border-border-strong"
              >
                <ChatCircleFill width={16} height={16} class="shrink-0 text-fg-strong" aria-hidden="true" />
                <p class="flex-1 text-sm text-fg text-pretty">{item.data.text}</p>
                <time class="font-mono text-xs text-fg-muted whitespace-nowrap" datetime={item.data.date.toISOString()}>
                  {formatDate(item.data.date)}
                </time>
              </Row>
            </li>
          );
        })
      }
    </ul>
  </section>
  )}
  <script is:inline>
    (() => {
      const tz = 'Europe/Madrid';
      const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: tz });
      const clock = document.getElementById('clock');
      const tick = () => (clock.textContent = fmt.format(new Date()));
      tick();
      setInterval(tick, 1000);
      // WMO weather codes bucketed to a condition word (matches data-cond icons)
      const wmo = (code) =>
        code <= 1 ? 'sunny'
        : code <= 3 ? 'cloudy'
        : code <= 48 ? 'foggy'
        : code <= 67 || (code >= 80 && code <= 82) ? 'rainy'
        : code <= 86 ? 'snowy'
        : 'stormy';
      fetch('https://api.open-meteo.com/v1/forecast?latitude=41.39&longitude=2.17&current=temperature_2m,weather_code')
        .then((r) => r.json())
        .then(({ current }) => {
          const temp = document.getElementById('temp');
          temp.textContent = Math.round(current.temperature_2m) + '°';
          temp.classList.add('weather-in'); // icon animates via display toggle; text spans need the class added
          const word = wmo(current.weather_code);
          document.querySelector(`[data-cond="${word}"]`).style.display = 'inline';
          const cond = document.getElementById('cond');
          cond.textContent = word;
          cond.classList.add('weather-in');
        })
        .catch(() => {}); // card still shows the time if the fetch fails
    })();
  </script>
</BaseLayout>
