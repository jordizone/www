---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Jordi Capellades"
  description="Personal site of Jordi Capellades — web developer. Thoughts, projects, and photography."
>
  <h1 class="sr-only">Jordi Capellades</h1>
  <section class="flex gap-4">
    <div>
      <div class="mt-2">
        <p class="text-fg text-xl">
          <span class="text-fg-emphasis font-medium text-xl">I'm Jordi</span>, a
          web developer. This is where I keep what I'm thinking about, what I'm
          building, and what I've seen. A small corner of the internet that's
          mine.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
