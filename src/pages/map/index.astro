---
import { getCollection, render } from "astro:content";
import { Undo2 } from "@lucide/astro";
import Figure from "../../components/Figure.astro";
import TravelDrawer from "../../components/TravelDrawer.tsx";
import "../../styles/global.css";

const posts = await getCollection("travels", ({ data }) => !data.draft);
const travels = await Promise.all(
  posts.map(async (post) => ({ post, Content: (await render(post)).Content })),
);

const places = posts.map((t) => ({
  title: t.data.title,
  lat: t.data.lat,
  lng: t.data.lng,
  slug: t.id,
}));

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Map · Jordi Capellades</title>
    <link
      rel="stylesheet"
      href="https://unpkg.com/maplibre-gl@5.1.0/dist/maplibre-gl.css"
      crossorigin=""
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=Geist+Mono:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      html,
      body,
      #map {
        height: 100%;
        margin: 0;
      }
      .map-back {
        position: absolute;
        top: 16px;
        left: 16px;
        z-index: 10;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 11px 7px 8px;
        border: 0;
        border-radius: var(--radius-md);
        background: var(--color-bg);
        /* shadow over border for depth that reads on any map color */
        box-shadow:
          0 1px 2px rgb(0 0 0 / 8%),
          0 2px 8px rgb(0 0 0 / 6%);
        font-family: var(--font-mono);
        font-size: 13px;
        line-height: 1;
        color: var(--color-fg-muted);
        text-decoration: none;
        transition:
          color 0.15s ease,
          background-color 0.15s ease,
          scale 0.1s ease,
          opacity 0.2s ease;
      }
      /* extend the clickable area beyond the small visible pill */
      .map-back::before {
        content: "";
        position: absolute;
        inset: -8px;
      }
      .map-back svg {
        transition: transform 0.15s ease;
      }
      .map-back:hover {
        color: var(--color-fg-strong);
        background: var(--color-surface-hover);
      }
      .map-back:hover svg {
        transform: translateX(-2px);
      }
      .map-back:active {
        scale: 0.96;
      }
      .map-back:focus-visible {
        outline: 2px solid var(--color-border-strong);
        outline-offset: 2px;
      }
      /* Hide the map back button while the drawer is open */
      html[data-travel-drawer="open"] .map-back {
        opacity: 0;
        pointer-events: none;
      }
      .travel-marker {
        display: flex;
        align-items: center;
        gap: 7px;
      }
      .travel-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #f2a900;
        border: 1.5px solid #333;
        flex: none;
      }
      .travel-label {
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--color-fg-strong);
        text-decoration: none;
        white-space: nowrap;
        background: var(--color-bg);
        border: 1px solid var(--color-border-strong);
        padding: 1px 6px;
        transition: background 0.15s;
      }
      .travel-label:hover {
        background: var(--color-surface-hover);
      }
      /* raise hovered marker above overlapping neighbours */
      .maplibregl-marker:hover {
        z-index: 1;
      }

      /* --- Base UI Drawer (bottom sheet) --- */
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      .td-backdrop {
        position: fixed;
        inset: 0;
        min-height: 100dvh;
        background: black;
        opacity: calc(0.35 * (1 - var(--drawer-swipe-progress, 0)));
        transition: opacity 450ms cubic-bezier(0.32, 0.72, 0, 1);
      }
      .td-backdrop[data-starting-style],
      .td-backdrop[data-ending-style] {
        opacity: 0;
      }
      .td-backdrop[data-swiping] {
        transition-duration: 0ms;
      }
      .td-backdrop[data-ending-style] {
        transition-duration: calc(var(--drawer-swipe-strength) * 400ms);
      }
      .td-viewport {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        touch-action: none;
      }
      .td-popup {
        box-sizing: border-box;
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        width: 100%;
        /* fixed height so short posts still open the sheet fully */
        height: calc(100dvh - var(--top-margin));
        padding-bottom: max(
          0px,
          calc(var(--drawer-snap-point-offset) + var(--drawer-swipe-movement-y))
        );
        border-top: 1px solid var(--color-border-strong);
        border-radius: 16px 16px 0 0;
        background: var(--color-bg);
        color: var(--color-fg);
        outline: 0;
        box-shadow: 0 -8px 30px rgb(0 0 0 / 12%);
        transition: transform 450ms cubic-bezier(0.32, 0.72, 0, 1);
        transform: translateY(
          calc(var(--drawer-snap-point-offset) + var(--drawer-swipe-movement-y))
        );
        will-change: transform;
      }
      .td-popup::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        top: 100%;
        height: 3rem;
        background: inherit;
        pointer-events: none;
      }
      .td-popup[data-starting-style],
      .td-popup[data-ending-style] {
        transform: translateY(calc(100% + 2px));
      }
      .td-popup[data-ending-style] {
        transition-duration: calc(var(--drawer-swipe-strength) * 400ms);
      }
      .td-draghandle {
        position: relative;
        z-index: 2; /* keep the handle + back button above .td-scroll */
        flex-shrink: 0;
        padding: 0.75rem 1.5rem 0.5rem;
        touch-action: none;
        user-select: none;
        cursor: grab;
      }
      .td-back {
        position: absolute;
        top: 0.4rem;
        left: 0.6rem;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 11px 7px 8px;
        border: 0;
        border-radius: var(--radius-md);
        background: transparent;
        font-family: var(--font-mono);
        font-size: 13px;
        line-height: 1;
        color: var(--color-fg-muted);
        cursor: pointer;
        transition:
          color 0.15s ease,
          background-color 0.15s ease,
          scale 0.1s ease;
      }
      /* extend hit area to ~40px tall without growing the visual */
      .td-back::before {
        content: "";
        position: absolute;
        inset: -4px;
      }
      .td-back svg {
        transition: transform 0.15s ease;
      }
      .td-back:hover {
        color: var(--color-fg-strong);
        background: var(--color-surface-hover);
      }
      .td-back:hover svg {
        transform: translateX(-2px);
      }
      .td-back:active {
        scale: 0.96;
      }
      .td-back:focus-visible {
        outline: 2px solid var(--color-border-strong);
        outline-offset: 2px;
      }
      .td-handle {
        width: 3rem;
        height: 0.25rem;
        margin: 0 auto;
        border-radius: 9999px;
        background: var(--color-border-strong);
      }
      .td-scroll {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        touch-action: auto;
        padding: 0.5rem 1.5rem calc(2rem + env(safe-area-inset-bottom, 0px));
        /* soft fade as content reaches the top edge under the handle */
        -webkit-mask-image: linear-gradient(
          to bottom,
          transparent 0,
          black 2.5rem
        );
        mask-image: linear-gradient(to bottom, transparent 0, black 2.5rem);
      }
      .td-article {
        max-width: 36rem;
        margin: 0 auto;
        padding-top: 38vh; /* pushes the title to ~center of the screen */
      }
    </style>
  </head>
  <body>
    <a href="/" class="map-back" aria-label="Back to home">
      <Undo2 class="h-4" aria-hidden="true" />back
    </a>
    <div id="map"></div>

    <TravelDrawer client:load />

    <div id="td-holder" hidden>
      {
        travels.map(({ post, Content }) => (
          <article id={`travel-${post.id}`} class="td-article">
            <header class="mb-6">
              <p class="font-mono text-sm text-fg-muted">
                {formatDate(post.data.date)}
              </p>
              <h1 class="font-serif text-4xl text-fg-strong">
                {post.data.title}
              </h1>
            </header>
            <div class="prose-content space-y-4 text-fg leading-relaxed">
              <Content components={{ Figure }} />
            </div>
          </article>
        ))
      }
    </div>

    <script
      type="application/json"
      id="places"
      set:html={JSON.stringify(places)}
    />
    <script
      is:inline
      src="https://unpkg.com/maplibre-gl@5.1.0/dist/maplibre-gl.js"
      crossorigin=""></script>
    <script is:inline>
      const map = new maplibregl.Map({
        container: "map",
        attributionControl: false,
        center: [0, 20],
        zoom: 1.5,
        // minimal 2-color style: grey land + blue water, no labels/roads
        style: {
          version: 8,
          sources: {
            openmaptiles: {
              type: "vector",
              url: "https://tiles.openfreemap.org/planet",
            },
          },
          layers: [
            {
              id: "land",
              type: "background",
              paint: { "background-color": "#e6e6e6" },
            },
            {
              id: "water",
              type: "fill",
              source: "openmaptiles",
              "source-layer": "water",
              paint: { "fill-color": "#a6d3ec" },
            },
          ],
        },
      });

      const places = JSON.parse(document.getElementById("places").textContent);
      for (const p of places) {
        const el = document.createElement("div");
        el.className = "travel-marker";
        const dot = document.createElement("div");
        dot.className = "travel-dot";
        const label = document.createElement("a");
        label.className = "travel-label";
        label.href = "/travels/" + p.slug; // fallback when JS/drawer unavailable
        label.textContent = p.title;
        label.addEventListener("click", (e) => {
          e.preventDefault();
          window.dispatchEvent(
            new CustomEvent("travel:open", { detail: p.slug }),
          );
        });
        el.append(dot, label);
        // anchor 'left' puts the dot on the coordinate, label to its right
        new maplibregl.Marker({ element: el, anchor: "left" })
          .setLngLat([p.lng, p.lat])
          .addTo(map);
      }
    </script>
  </body>
</html>
