---
import { getCollection } from "astro:content";
import { Folder, FolderOpen, FileText, ArrowUpRight } from "@lucide/astro";
import { sections } from "../data/nav";

const MAX_ITEMS = 10;

type ChildItem = { href: string; label: string };

const buildSection = async (
  collection: "writing" | "projects" | "lab",
  base: string,
) => {
  const entries = (await getCollection(collection)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  const items: ChildItem[] = entries.slice(0, MAX_ITEMS).map((entry) => ({
    href: `${base}/${entry.id}`,
    label: entry.data.title,
  }));
  return { items, hasMore: entries.length > MAX_ITEMS };
};

const itemsBySection: Record<string, { items: ChildItem[]; hasMore: boolean }> =
  {
    "/writing": await buildSection("writing", "/writing"),
    "/projects": await buildSection("projects", "/projects"),
    "/lab": await buildSection("lab", "/lab"),
    "/photos": { items: [], hasMore: false },
  };

const pathname = Astro.url.pathname;
const isUnder = (href: string) =>
  pathname === href || pathname.startsWith(href + "/");
const isActiveItem = (href: string) => pathname === href;

const keyOf = (href: string) => href.replace(/^\//, "");
---

<nav aria-label="Sections" class="text-lg">
  <ul class="space-y-px">
    {
      sections.map((section) => {
        const key = keyOf(section.href);
        const { items, hasMore } = itemsBySection[section.href] ?? {
          items: [],
          hasMore: false,
        };
        const expanded = isUnder(section.href);
        const sectionActive = isUnder(section.href);
        const sectionCurrent = pathname === section.href;
        const showSeeMore = hasMore || items.length === 0;
        return (
          <li data-section={key} data-expanded={expanded ? "true" : "false"}>
            <button
              type="button"
              class:list={[
                "folder-row group flex items-center gap-1.5 w-full px-1.5 py-1 rounded transition-colors text-left",
                sectionActive
                  ? "bg-surface-hover text-fg-strong"
                  : "text-fg hover:bg-surface-hover",
              ]}
              aria-expanded={expanded ? "true" : "false"}
              aria-controls={`${key}-children`}
              aria-current={sectionCurrent ? "page" : undefined}
              data-disclosure={key}
              data-folder-href={section.href}
            >
              <span class="folder-icon-btn relative flex items-center justify-center w-6 h-6 shrink-0 text-fg-muted group-hover:text-fg-strong transition-colors">
                <Folder
                  size={20}
                  stroke-width={1.5}
                  class="folder-closed absolute"
                />
                <FolderOpen
                  size={20}
                  stroke-width={1.5}
                  class="folder-open absolute"
                />
              </span>
              <span class="truncate">{section.label}</span>
            </button>

            <div class="sidebar-children-wrap">
              <ul
                id={`${key}-children`}
                class="sidebar-children space-y-px pt-px text-base"
              >
                {items.map((item) => {
                  const active = isActiveItem(item.href);
                  return (
                    <li>
                      <a
                        href={item.href}
                        data-active-href={item.href}
                        aria-current={active ? "page" : undefined}
                        class:list={[
                          "flex items-center gap-1.5 pl-5 pr-1.5 py-1 rounded transition-colors",
                          active
                            ? "bg-surface-hover text-fg-strong"
                            : "text-fg-muted hover:text-fg hover:bg-surface-hover",
                        ]}
                      >
                        <span class="flex items-center justify-center w-6 h-6 shrink-0">
                          <FileText size={17} stroke-width={1.5} />
                        </span>
                        <span class="truncate">{item.label}</span>
                      </a>
                    </li>
                  );
                })}
                {showSeeMore && (
                  <li>
                    <a
                      href={section.href}
                      class="flex items-center gap-1.5 pl-5 pr-1.5 py-1 rounded text-fg-muted hover:text-fg hover:bg-surface-hover transition-colors"
                    >
                      <span class="flex items-center justify-center w-6 h-6 shrink-0">
                        <ArrowUpRight size={17} stroke-width={1.5} />
                      </span>
                      <span class="truncate">
                        {items.length === 0
                          ? `Open ${section.label.toLowerCase()}`
                          : `View all ${section.label.toLowerCase()}`}
                      </span>
                    </a>
                  </li>
                )}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ul>
</nav>
