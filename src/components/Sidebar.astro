---
import SidebarNav from './SidebarNav.astro';
import SocialLinks from './SocialLinks.astro';
---

<aside id="sidebar" class="flex flex-col px-6 py-8" transition:persist="sidebar">
  <a href="/" class="text-md font-medium text-fg-strong hover:text-fg transition-colors">
    Jordi
  </a>

  <div class="mt-12 flex-1">
    <SidebarNav />
  </div>

  <div class="mt-8">
    <SocialLinks />
  </div>
</aside>

<button
  type="button"
  id="sidebar-backdrop"
  aria-label="Close sidebar"
  transition:persist="sidebar-backdrop"
></button>
